rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site content: public read (the website renders from it),
    // writes only for admin accounts listed below.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'liutswim@gmail.com',
          'valvdov@gmail.com'
        ];
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
